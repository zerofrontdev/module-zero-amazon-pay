{
    "name": "zerofront/module-zero-amazon-pay",
    "description": "Zero for Magento Open Source: Amazon Pay for Zero Checkout: the customer pays on Amazon's page after placing the order, no Amazon script on the shop's pages.",
    "type": "magento2-module",
    "version": "1.3.6",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "amazon-pay",
        "payment"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-config": "*",
        "magento/module-directory": "*",
        "magento/module-payment": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "amzn/amazon-pay-api-sdk-php": "^2.6",
        "zerofront/module-zero-checkout": "^1.3.6"
    },
    "replace": {
        "fixstacks/module-zero-amazon-pay": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\AmazonPay\\": ""
        }
    }
}
